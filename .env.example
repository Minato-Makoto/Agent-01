# AgentForge runtime env example
# Do not put secrets in this file when committing.

# Provider: local | openai_compatible
PROVIDER=local

# Local backend
SERVER_EXE=llama-b8069-bin-win-cuda-13.1-x64\llama-server.exe
MODEL_PATH=

# Remote backend
BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-5-mini
API_KEY_ENV=OPENAI_API_KEY

# Runtime tuning
CTX_SIZE=16384
GPU_LAYERS=-1
THREADS=0
TEMPERATURE=0.1
TOP_P=0.9
TOP_K=40
REPEAT_PENALTY=1.1
SEED=-1
REASONING_FORMAT=auto
REASONING_EFFORT=
MAX_TOKENS=8192
HOST=127.0.0.1
PORT=8080
BOOT_TIMEOUT=120
HEALTH_TIMEOUT=2
REQUEST_TIMEOUT=300
COMPAT_RETRY_LIMIT=8
WORKSPACE=workspace
