# AgentForge runtime env example
# Do not put secrets in this file when committing.

# Provider: local | openai_compatible
PROVIDER=local

# Local backend
SERVER_EXE=llama-b8069-bin-win-cuda-13.1-x64\llama-server.exe
MODEL_PATH=

# Remote backend
BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-5-mini
API_KEY_ENV=OPENAI_API_KEY

# Runtime tuning
CTX_SIZE=16384
GPU_LAYERS=-1
THREADS=0
TEMPERATURE=0.1
TOP_P=0.9
TOP_K=40
REPEAT_PENALTY=1.1
SEED=-1
REASONING_EFFORT=
MAX_TOKENS=8192
HOST=127.0.0.1
PORT=8080
BOOT_TIMEOUT=120
HEALTH_TIMEOUT=2
REQUEST_TIMEOUT=300
SHUTDOWN_TIMEOUT=5
COMPAT_RETRY_LIMIT=8
MAX_REQUESTS_PER_MINUTE=60
WORKSPACE=workspace
MAX_ITERATIONS=10
MAX_REPEATS=3
AGENT_TIMEOUT=300

# Tool timeout policy
TOOL_TIMEOUT_BROWSER_NAV_MS=30000
TOOL_TIMEOUT_BROWSER_ACTION_MS=5000
TOOL_TIMEOUT_BROWSER_WAIT_MS=10000
TOOL_TIMEOUT_WEB_REQUEST_S=30
TOOL_TIMEOUT_WEB_SEARCH_S=15
TOOL_TIMEOUT_PHOTOSHOP_S=30
TOOL_TIMEOUT_PROCESS_LIST_S=10

# Shell policy: 1 = workspace-only default, 0 = allow broader cwd
SHELL_WORKSPACE_ONLY=1
