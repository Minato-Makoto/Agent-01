from __future__ import annotations

import argparse
import importlib.util
import json
import os
import sys
import time
from pathlib import Path
from typing import Any, Callable


ROOT = Path(__file__).resolve().parent
SANDBOX_ROOT = ROOT / ".ui_dummy_preview"
SANDBOX_AGENTFORGE = SANDBOX_ROOT / "agentforge"
SANDBOX_FILES = ("__init__.py", "ui.py", "model_output_renderer.py")
DUMMY_PACKAGE = "_ui_dummy_runtime"


REASONING_TEXT = (
    "Inspecting parser flow and validating schema contracts...\n"
    "Step 1/5: checking callback lifecycle + stream boundaries.\n"
    "Step 2/5: validating lane palette transitions.\n"
    "Step 3/5: scanning tool-call blocks for truncation and wrapping.\n"
    "Step 4/5: replaying markdown chunks with quote/hr/code.\n"
    "Step 5/5: finalizing state before the next block.\n"
)
OUTPUT_TEXT = """## Plan
We'll patch the parser and keep callbacks stable.

> Streaming markdown is rendered inline.

---

```python
def parse(payload: dict) -> dict:
    return {"ok": True, "size": len(payload)}
```

Result is ready.
"""


def _clear_terminal() -> None:
    os.system("cls" if sys.platform == "win32" else "clear")


def _force_utf8_stdio() -> None:
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if callable(reconfigure):
            try:
                reconfigure(encoding="utf-8", errors="replace")
            except OSError:
                pass


def _purge_dummy_modules() -> None:
    keys = [
        name
        for name in sys.modules
        if name == DUMMY_PACKAGE or name.startswith(f"{DUMMY_PACKAGE}.")
    ]
    for key in keys:
        sys.modules.pop(key, None)


def _purge_forbidden_source_modules() -> None:
    keys = [
        name
        for name in sys.modules
        if name == "agentforge" or name.startswith("agentforge.")
    ]
    for key in keys:
        sys.modules.pop(key, None)


def _sandbox_ready() -> bool:
    return all((SANDBOX_AGENTFORGE / name).is_file() for name in SANDBOX_FILES)


def _load_chat_ui() -> type:
    _purge_forbidden_source_modules()
    _purge_dummy_modules()

    init_file = SANDBOX_AGENTFORGE / "__init__.py"
    package_spec = importlib.util.spec_from_file_location(
        DUMMY_PACKAGE,
        init_file,
        submodule_search_locations=[str(SANDBOX_AGENTFORGE)],
    )
    if package_spec is None or package_spec.loader is None:
        raise RuntimeError(f"Cannot load sandbox package from: {init_file}")

    package_module = importlib.util.module_from_spec(package_spec)
    sys.modules[DUMMY_PACKAGE] = package_module
    package_spec.loader.exec_module(package_module)

    ui_file = SANDBOX_AGENTFORGE / "ui.py"
    ui_spec = importlib.util.spec_from_file_location(f"{DUMMY_PACKAGE}.ui", ui_file)
    if ui_spec is None or ui_spec.loader is None:
        raise RuntimeError(f"Cannot load sandbox ui module from: {ui_file}")

    ui_module = importlib.util.module_from_spec(ui_spec)
    sys.modules[f"{DUMMY_PACKAGE}.ui"] = ui_module
    ui_spec.loader.exec_module(ui_module)

    chat_ui = getattr(ui_module, "ChatUI", None)
    if chat_ui is None:
        raise RuntimeError("ChatUI not found in sandbox runtime.")

    leaked_source = [
        name
        for name in sys.modules
        if name == "agentforge" or name.startswith("agentforge.")
    ]
    if leaked_source:
        leaked = ", ".join(sorted(leaked_source))
        raise RuntimeError(
            "Forbidden source namespace detected during dummy load: "
            f"{leaked}"
        )

    return chat_ui


def _sandbox_signature() -> tuple[tuple[str, int, int], ...]:
    signature: list[tuple[str, int, int]] = []
    for name in SANDBOX_FILES:
        path = SANDBOX_AGENTFORGE / name
        if not path.is_file():
            signature.append((name, -1, -1))
            continue
        stat = path.stat()
        signature.append((name, stat.st_mtime_ns, stat.st_size))
    return tuple(signature)


def _sleep(seconds: float) -> None:
    if seconds > 0:
        time.sleep(seconds)


def _stream_text(callback, text: str, delay: float) -> None:
    for ch in text:
        callback(ch)
        _sleep(delay)


def _stream_text_chunks(callback, text: str, delay: float, chunk_size: int = 32) -> None:
    size = max(1, int(chunk_size))
    for idx in range(0, len(text), size):
        callback(text[idx : idx + size])
        _sleep(delay)


def _stream_tool_call(ui: Any, name: str, arguments: dict, delay: float) -> None:
    payload = json.dumps(arguments, ensure_ascii=False, indent=2)
    start = getattr(ui, "tool_call_stream_start", None)
    stream = getattr(ui, "tool_call_stream_token", None)
    end = getattr(ui, "tool_call_stream_end", None)

    if callable(start) and callable(stream) and callable(end):
        start(name)
        _stream_text_chunks(stream, payload, delay)
        end()
        return

    ui.show_tool_call(name, arguments)


def _emit_user_line(ui: Any, text: str) -> None:
    print(f"> {text}", flush=True)


def _tool_args_payload() -> dict:
    docs_long = (
        "This payload intentionally carries a long mixed markdown/html/docs body "
        "to validate wrapping and streaming for command arguments. "
    ) * 18
    html_long = (
        "<article><h1>Runtime UI Preview</h1><p>The command block should wrap long "
        "inline HTML safely without clipping lanes.</p></article>"
    )
    return {
        "path": "workspace/AGENT.md",
        "include": [
            "docs/BLUEPRINT_VI.md",
            "docs/TUTORIAL.md",
            "workspace/skills/system/SKILL.md",
        ],
        "mode": "stream_preview",
        "parse_as": "markdown+html",
        "max_chars": 24000,
        "docs_excerpt": docs_long,
        "html_preview": html_long * 3,
        "extra_html_sections": [
            "<section><h2>Spec A</h2><p>Long html fragment for wrapping checks.</p></section>"
            * 2,
            "<section><h2>Spec B</h2><p>Ensure nested-like content is visible without truncation.</p></section>"
            * 2,
        ],
        "notes": {
            "source": "docs + html + markdown",
            "intention": "force long payload rendering in tool block",
        },
    }


def _tool_error_payload(args: dict) -> dict:
    traceback_long = (
        "Traceback (most recent call last):\n"
        '  File "workspace/tools/read_file.py", line 118, in execute\n'
        "    raise TimeoutError('read_file exceeded execution budget while parsing large html/doc payload')\n"
        "TimeoutError: read_file exceeded execution budget while parsing large html/doc payload\n"
    ) * 2
    return {
        "ok": False,
        "status": "error",
        "error": "tool execution aborted by runtime timeout.",
        "tool": "read_file",
        "path": args.get("path"),
        "attempt": 1,
        "timeout_seconds": 30,
        "traceback": traceback_long,
        "context": {
            "parse_as": args.get("parse_as"),
            "max_chars": args.get("max_chars"),
            "include": args.get("include"),
            "html_preview": args.get("html_preview"),
            "docs_excerpt": args.get("docs_excerpt"),
        },
    }


def _run_success_turn(ui: Any, prompt: str, delay: float) -> None:
    _emit_user_line(ui, prompt)
    ui.thinking_start()
    _sleep(delay * 8)
    _stream_text(ui.stream_reasoning, REASONING_TEXT, delay)
    ui.thinking_stop()
    # Match runtime callback order: thinking_end is followed by stream_end
    # even when the model produced reasoning-only output for this iteration.
    ui.stream_end()
    _sleep(delay * 10)

    args = _tool_args_payload()
    _stream_tool_call(ui, "read_file", args, delay)
    _sleep(delay * 8)
    ui.show_tool_result(
        "read_file",
        {
            "ok": True,
            "bytes": 4823,
            "path": args["path"],
            "note": "Full payload kept for long-wrap preview (no truncation).",
            "meta": {
                "parse_as": args["parse_as"],
                "max_chars": args["max_chars"],
                "include_count": len(args["include"]),
            },
            "preview": {
                "docs_excerpt": args["docs_excerpt"],
                "html_preview": args["html_preview"],
                "extra_html_sections": args["extra_html_sections"],
            },
        },
    )
    _sleep(delay * 12)

    ui.thinking_start()
    _sleep(delay * 6)
    _stream_text(ui.stream_token, OUTPUT_TEXT, delay)
    ui.stream_end()


def _run_error_turn(ui: Any, prompt: str, delay: float) -> None:
    _emit_user_line(ui, prompt)
    ui.thinking_start()
    _sleep(delay * 8)
    _stream_text(ui.stream_reasoning, REASONING_TEXT, delay)
    ui.thinking_stop()
    ui.stream_end()
    _sleep(delay * 10)

    args = _tool_args_payload()
    _stream_tool_call(ui, "read_file", args, delay)
    _sleep(delay * 8)
    ui.show_tool_result("read_file", _tool_error_payload(args))
    _sleep(delay * 8)
    ui.error("tool execution aborted by runtime timeout.")


def _run_demo(ui: Any, scenario: str, delay: float) -> None:
    if scenario in {"success", "both"}:
        _run_success_turn(
            ui,
            "Refactor parser and show progress.",
            delay,
        )
        _sleep(delay * 35)

    if scenario in {"error", "both"}:
        _run_error_turn(
            ui,
            "Run the same flow but force timeout.",
            delay,
        )


def _run_once(chat_ui_factory: Callable[..., Any], args: argparse.Namespace) -> None:
    ui = chat_ui_factory(verbose=bool(args.verbose))
    ui.welcome(
        model_name="qwen3vl-local",
        tools=[],
        session_id="preview-session",
        skill_count=7,
        total_tool_count=24,
        workspace=str((ROOT / "workspace").resolve()),
        provider="preview-sandbox",
    )
    try:
        _run_demo(ui, args.scenario, max(0.0, args.delay))
    finally:
        ui.goodbye()


def _run_watch(args: argparse.Namespace) -> int:
    interval = max(0.1, args.watch_interval)
    last_signature: tuple[tuple[str, int, int], ...] | None = None
    print(
        f"[watch] Edit files in: {SANDBOX_AGENTFORGE}\n"
        "        Auto-refresh preview on save. Ctrl+C to stop.\n",
        flush=True,
    )
    try:
        while True:
            signature = _sandbox_signature()
            if signature != last_signature:
                last_signature = signature
                _clear_terminal()
                print(
                    f"[watch] Reloaded sandbox from: {SANDBOX_AGENTFORGE}",
                    flush=True,
                )
                chat_ui = _load_chat_ui()
                _run_once(chat_ui, args)
                print("", flush=True)
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\n[watch] Stopped.", flush=True)
        return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Live terminal preview for AgentForge UI. "
            "This runner is sandbox-only and defaults to live preview mode."
        ),
    )
    parser.add_argument(
        "--scenario",
        choices=("success", "error", "both"),
        default="both",
        help="Demo flow to render.",
    )
    parser.add_argument(
        "--delay",
        type=float,
        default=0.012,
        help="Per-character stream delay in seconds.",
    )
    parser.add_argument(
        "--theme",
        choices=("auto", "dark", "light"),
        default="auto",
        help="Override AGENTFORGE_UI_THEME for preview.",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable verbose welcome metadata (runtime/tools/workspace).",
    )
    parser.add_argument(
        "--watch",
        action="store_true",
        help="Alias for default mode (watch files and auto-refresh on save).",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="Run one demo pass and exit (default is live preview).",
    )
    parser.add_argument(
        "--watch-interval",
        type=float,
        default=0.4,
        help="Polling interval in seconds for --watch.",
    )
    return parser.parse_args()


def main() -> int:
    _force_utf8_stdio()
    args = parse_args()
    if args.theme != "auto":
        os.environ["AGENTFORGE_UI_THEME"] = args.theme

    if not _sandbox_ready():
        print(
            "Sandbox runtime files are missing in .ui_dummy_preview/agentforge.",
            file=sys.stderr,
        )
        return 1

    if not args.once or args.watch:
        return _run_watch(args)

    chat_ui = _load_chat_ui()
    try:
        _run_once(chat_ui, args)
    except KeyboardInterrupt:
        print("\nPreview interrupted by user.", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
